{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodev.local/schemas/v2/agent.schema.json",
  "title": "AutoDev Agent Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "kind", "id", "version", "hostApi", "capabilities", "io", "entrypoint"],
  "properties": {
    "schemaVersion": { "enum": ["2.0", "2.1"] },
    "kind": { "const": "Agent" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
    "hostApi": { "type": "string" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "enum": [
              "code.implementation",
              "code.refactor",
              "planning.decompose",
              "security.review",
              "validation.plan"
            ]
          },
          "version": { "type": "string" },
          "level": { "enum": ["primary", "secondary"] }
        }
      }
    },
    "io": {
      "type": "object",
      "required": ["contract", "contractVersion", "input", "output"],
      "properties": {
        "contract": { "type": "string" },
        "contractVersion": { "type": "string" },
        "input": { "type": "object" },
        "output": { "type": "object" },
        "onInvalidOutput": { "enum": ["repair-then-fail", "fail", "passthrough"] }
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "object",
          "properties": {
            "input": { "type": "integer", "minimum": 1 },
            "output": { "type": "integer", "minimum": 1 }
          }
        },
        "costUsd": { "type": "number", "exclusiveMinimum": 0 },
        "wallClockSeconds": { "type": "integer", "minimum": 1 },
        "maxSteps": { "type": "integer", "minimum": 1 },
        "maxToolCalls": { "type": "integer", "minimum": 1 },
        "onExceeded": { "enum": ["fail-closed", "degrade", "ask-human"] }
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "network": { "enum": ["none", "declared"] },
        "tools": { "type": "array" },
        "skills": { "type": "array" }
      }
    },
    "entrypoint": {
      "type": "object",
      "required": ["runtime", "ref"],
      "properties": {
        "runtime": { "const": "python" },
        "ref": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "requiredCapabilities": {
          "type": "array",
          "items": { "enum": ["text", "tool_calling", "structured_output", "streaming"] }
        },
        "fallbackOn": {
          "type": "array",
          "items": {
            "enum": [
              "provider_not_configured",
              "unsupported_capability",
              "authentication",
              "invalid_request",
              "timeout",
              "rate_limit",
              "unavailable",
              "budget_exceeded",
              "provider_error"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxCalls": { "type": "integer", "minimum": 1 },
            "maxTotalTokens": { "type": "integer", "minimum": 1 },
            "maxCostUsd": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "fallback": {
          "type": "array",
          "items": { "$ref": "#/$defs/modelTarget" }
        }
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "modelTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["model"] },
      "then": { "properties": { "schemaVersion": { "const": "2.1" } } }
    },
    {
      "not": {
        "required": ["model", "policy"],
        "properties": { "policy": { "required": ["model"] } }
      }
    }
  ]
}
