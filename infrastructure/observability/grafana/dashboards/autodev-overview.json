{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(http_server_request_duration_count[5m])) by (http_route)", "legendFormat": "{{http_route}}", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Ratio",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "autodev:http_error_ratio:rate5m", "legendFormat": "error ratio", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "title": "HTTP Latency p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "autodev:http_latency_p95_seconds:rate5m", "legendFormat": "{{http_route}}", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "title": "Run and Step Latency p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, autodev_flow) (rate(autodev_run_duration_bucket[5m])))", "legendFormat": "run {{autodev_flow}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, autodev_agent) (rate(autodev_run_step_duration_bucket[5m])))", "legendFormat": "step {{autodev_agent}}", "refId": "B"}
      ]
    },
    {
      "id": 5,
      "title": "Model Latency p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_duration_bucket[5m])))", "legendFormat": "{{gen_ai_request_model}}", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "title": "Cost by Tenant",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "sum(increase(autodev_model_cost_usd_total[$__range])) by (autodev_tenant)", "legendFormat": "{{autodev_tenant}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "title": "Tokens by Tenant",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {"expr": "sum(increase(autodev_model_tokens_total[$__range])) by (autodev_tenant, gen_ai_token_type)", "legendFormat": "{{autodev_tenant}} {{gen_ai_token_type}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "title": "Agent Quality",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {"expr": "sum(autodev_agent_quality_ratio_sum) by (autodev_agent) / clamp_min(sum(autodev_agent_quality_ratio_count) by (autodev_agent), 1)", "legendFormat": "{{autodev_agent}}", "refId": "A"}
      ]
    },
    {
      "id": 9,
      "title": "Queue Depth",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {"expr": "autodev_queue_jobs{state=\"pending\"}", "legendFormat": "{{backend}}", "refId": "A"}
      ]
    },
    {
      "id": 10,
      "title": "Worker Utilization",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [
        {"expr": "autodev_worker_utilization", "legendFormat": "{{backend}}", "refId": "A"}
      ]
    },
    {
      "id": 11,
      "title": "Postgres Pool Available Connections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "targets": [
        {"expr": "autodev_postgres_pool_stat{stat=\"pool_available\"}", "legendFormat": "available", "refId": "A"},
        {"expr": "autodev_postgres_pool_stat{stat=\"requests_waiting\"}", "legendFormat": "waiting", "refId": "B"}
      ]
    },
    {
      "id": 12,
      "title": "Postgres Pool Wait p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(autodev_postgres_pool_wait_duration_bucket[5m])))", "legendFormat": "{{outcome}}", "refId": "A"}
      ]
    },
    {
      "id": 13,
      "title": "Postgres Deadlock Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
      "targets": [
        {"expr": "sum(rate(autodev_postgres_transient_error_count_total{error_type=\"PostgresDeadlockError\"}[5m]))", "legendFormat": "deadlocks", "refId": "A"},
        {"expr": "sum(rate(autodev_postgres_transient_error_count_total{error_type=\"PostgresSerializationFailureError\"}[5m]))", "legendFormat": "serialization failures", "refId": "B"}
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["autodev", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "AutoDev Overview",
  "uid": "autodev-overview",
  "version": 2
}
