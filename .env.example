# Backend runtime
AUTODEV_PROFILE=local
AUTODEV_SETTINGS_FILE=
DATABASE_URL=sqlite:///./autodev.db
LLM_PROVIDER=stub
# Set LLM_PROVIDER=openai to enable a real agent API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0.2
# Development only: set to false when the LLM endpoint uses a self-signed
# certificate (e.g. corporate proxy). Disabling TLS verification exposes the API
# key to man-in-the-middle attacks — never do this in production.
OPENAI_VERIFY_SSL=true
UVICORN_RELOAD=true
AUTODEV_PROJECT_ROOT=
AUTODEV_CONFIG_PATH=
AUTODEV_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where the GET / service descriptor points humans at the product UI.
# Defaults to the first default CORS origin (http://localhost:3000).
# Uncomment to override (leave commented — an empty value counts as set):
# AUTODEV_UI_URL=http://localhost:3000

# API authentication (opt-in). Leave empty to keep the API open for local
# development. Set a strong random token to require
# `Authorization: Bearer <token>` on every request (except /health and docs).
# This legacy PAT never satisfies production readiness (ADR-018) — see the
# OIDC settings below, or `autodev auth service-key create`.
AUTODEV_API_TOKEN=

# Control Plane authentication (E11-S2). Production requires either these
# OIDC settings to be complete, or at least one active service credential.
AUTODEV_OIDC_ISSUER=
AUTODEV_OIDC_AUDIENCE=
AUTODEV_OIDC_JWKS_URL=
AUTODEV_OIDC_AUTHORIZATION_URL=
AUTODEV_OIDC_TOKEN_URL=
AUTODEV_OIDC_CLIENT_ID=
AUTODEV_OIDC_CLIENT_SECRET=
AUTODEV_OIDC_ROLE_CLAIM=roles
AUTODEV_OIDC_TENANT_CLAIM=tenant_id
AUTODEV_OIDC_SCOPE_CLAIM=scope
AUTODEV_OIDC_ALGORITHMS=RS256
AUTODEV_OIDC_JWKS_TTL_SECONDS=3600
AUTODEV_SESSION_ENCRYPTION_KEY=
AUTODEV_SESSION_TTL_SECONDS=28800

# Bind address / port for sandbox/run_orchestrator.py (defaults are loopback).
# Set AUTODEV_HOST=0.0.0.0 only behind a trusted proxy or with a token set.
AUTODEV_HOST=127.0.0.1
AUTODEV_PORT=8000

# Validation sandbox (all disabled by default).
# AUTODEV_ENABLE_SANDBOX=1        # enable command execution
# AUTODEV_SANDBOX_ALLOW_LOCAL=1   # allow UNSANDBOXED host execution when Docker is absent
# AUTODEV_SANDBOX_DOCKER_NETWORK=none  # container network mode (default: none)

# Jobs, Redis locks, and artifact storage.
AUTODEV_JOB_BACKEND=inprocess
AUTODEV_REDIS_URL=
STORAGE_BACKEND=local
AUTODEV_ARTIFACT_DIR=/data/artifacts
AUTODEV_MINIO_ENDPOINT=
AUTODEV_MINIO_BUCKET=autodev-artifacts
AUTODEV_MINIO_ACCESS_KEY=
AUTODEV_MINIO_SECRET_KEY=
AUTODEV_MINIO_SECURE=false

# OpenTelemetry. Set OTEL_ENABLED=false for an emergency rollback to no-op
# tracing/metrics/logging with zero Collector dependency.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=autodev-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL_MS=5000

# Self-hosted observability stack retention (make observability-up).
AUTODEV_OBSERVABILITY_TRACE_RETENTION=168h
AUTODEV_OBSERVABILITY_METRIC_RETENTION=15d
AUTODEV_OBSERVABILITY_LOG_RETENTION=168h

# Frontend runtime
NEXT_PUBLIC_API_URL=http://localhost:8000
